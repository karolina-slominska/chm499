import os
import pandas as pd
from tkinter import Tk, filedialog
from rdkit import RDLogger
from rdkit.Chem import MolFromSmiles, MolToSmiles

RDLogger.DisableLog('rdApp.*')

def standardize_smiles(smi: str):
    """Run RDKit standardization pipeline and return (canonical_smiles, reason)."""
    if not smi or pd.isna(smi):
        return None, "No SMILES present"
    try:
        mol = MolFromSmiles(str(smi).strip(), sanitize=True)
        if not mol:
            return None, "Parsing failed"
        can_smi = MolToSmiles(mol, canonical=True, isomericSmiles=True)
        return can_smi, None
    except Exception as e:
        msg = str(e).lower()
        if "kekul" in msg:
            return None, "Kekulization issue"
        if "valence" in msg:
            return None, "Valence issue"
        return None, "Other RDKit error"

def fetch_pubchem_by_cas(cas):
    """Fetch canonical SMILES from PubChem using CAS RN."""
    if not HAS_PUBCHEMPY or not cas or pd.isna(cas):
        return None
    try:
        comps = pcp.get_compounds(str(cas), "name")
        if comps:
            return comps[0].canonical_smiles
    except Exception:
        return None
    return None

def fetch_pubchem_by_name(name):
    """Fetch canonical SMILES from PubChem using compound name."""
    if not HAS_PUBCHEMPY or not name or pd.isna(name):
        return None
    try:
        comps = pcp.get_compounds(str(name), "name")
        if comps:
            return comps[0].canonical_smiles
    except Exception:
        return None
    return None


# Main pipeline

if __name__ == "__main__":
    Tk().withdraw()
    print("Select your merged PPDB+BPDB Excel file")
    file_path = filedialog.askopenfilename(
        title="Select merged PPDB+BPDB file",
        filetypes=[("Excel files", "*.xlsx")]
    )
    if not file_path:
        raise SystemExit("No file selected.")

    df = pd.read_excel(file_path)
    print(f"Loaded {len(df)} rows")

    checked_smiles, reasons = [], []

    for _, row in df.iterrows():
        # --- Step 1: Try Canonical or Isomeric from file ---
        smi = row.get("Canonical SMILES") or row.get("Isomeric SMILES")
        can_smi, reason = standardize_smiles(smi)

        # --- Step 2: If no valid SMILES, try PubChem by CAS ---
        if not can_smi and HAS_PUBCHEMPY:
            cas = row.get("CAS RN")
            if cas:
                pubchem_smi = fetch_pubchem_by_cas(cas)
                if pubchem_smi:
                    can_smi, reason = standardize_smiles(pubchem_smi)

        # --- Step 3: If still None, try PubChem by Name ---
        if not can_smi and HAS_PUBCHEMPY:
            name = row.get("Name")
            if name:
                pubchem_smi = fetch_pubchem_by_name(name)
                if pubchem_smi:
                    can_smi, reason = standardize_smiles(pubchem_smi)

        # --- Step 4: Mark results ---
        checked_smiles.append(can_smi)
        if can_smi:
            reasons.append("OK")
        else:
            if not HAS_PUBCHEMPY and reason == "No SMILES present":
                reasons.append("PubChem not available")
            else:
                reasons.append(reason)

    df["Checked SMILES"] = checked_smiles
    df["SMILES_Status"] = reasons

    out_dir = os.path.dirname(file_path) or "."

    #  Save valid ones
    valid_df = df[df["Checked SMILES"].notna()]
    valid_path = os.path.join(out_dir, "valid_smiles.xlsx")
    valid_df.to_excel(valid_path, index=False)
    print(f"Saved {len(valid_df)} valid compounds -> {valid_path}")

    #  Save invalid ones
    invalid_df = df[df["Checked SMILES"].isna()]
    invalid_path = os.path.join(out_dir, "invalid_smiles_with_reasons.xlsx")
    invalid_df.to_excel(invalid_path, index=False)
    print(f"Saved {len(invalid_df)} invalid compounds -> {invalid_path}")

    # Deduplicated dataset
    dedup_df = valid_df.drop_duplicates(subset=["CAS RN", "Checked SMILES", "Name"])
    dedup_path = os.path.join(out_dir, "ppdbbpdb_smiles_deduplicated.xlsx")
    dedup_df.to_excel(dedup_path, index=False)
    print(f"Saved deduplicated database -> {dedup_path}")
